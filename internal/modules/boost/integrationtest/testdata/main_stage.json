      "default": false,
      "visible_when": {
        "mode": "sweep"
      }
    },
    {
      "key": "auto_team",
      "type": "switch",
      "label": "自动编队",
      "help": "关闭则使用你在游戏里保存的第一队",
      "default": true,
      "points": 0
    },
    {
      "key": "remark",
      "type": "text",
      "label": "备注",
