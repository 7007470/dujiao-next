  {
    "key": "starfall_idle",
    "label": "挂机采集（按分钟计费）",
    "definition": {
      "schema_version": 1,
      "code": "idle_farm",
      "name": "挂机采集",
      "description": "在指定区域循环采集材料，按运行分钟扣点。",
      "capability": "idle",
      "timeout_minutes": 540,
      "max_active_per_user": 2,
      "refund_policy": "prorate",
      "member_discount": false,
      "fields": [
        {
          "key": "area",
          "type": "select",
          "label": "采集区域",
          "required": true,
          "options": [
            {
              "value": "plain",
              "label": "晨曦平原"
            },
            {
              "value": "valley",
              "label": "雾隐山谷"
            },
            {
              "value": "coast",
              "label": "沉星海岸"
            }
          ]
        },
        {
          "key": "minutes",
          "type": "number",
          "label": "运行时长",
          "unit": "分钟",
          "min": 30,
          "max": 480,
          "default": 60,
          "points_per": 1
        }
      ]
    }
  },
  {
    "key": "ironcrest_farm",
    "label": "挂机刷野（开关附加项）",
    "definition": {
      "schema_version": 1,
      "code": "farm",
      "name": "资源收取 + 联盟帮助",
