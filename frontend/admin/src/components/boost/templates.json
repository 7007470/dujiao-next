        {
          "key": "mode",
          "type": "radio",
          "label": "模式",
          "required": true,
          "default": "sweep",
          "options": [
            {
              "value": "clear",
              "label": "通关（拿三星）"
            },
            {
              "value": "sweep",
              "label": "扫荡"
            }
          ]
        },
        {
          "key": "stages",
          "type": "stage_picker",
          "label": "选择关卡",
          "catalog": "main",
          "multiple": true,
          "max_select": 12,
          "required": true,
          "cost_by": "mode",
          "count": {
            "label": "扫荡次数",
            "min": 1,
            "max": 99,
            "default": 10,
            "visible_when": {
              "mode": "sweep"
            }
          }
        },
        {
          "key": "use_stamina_potion",
          "type": "switch",
          "label": "体力不足时使用体力药",
          "help": "只消耗背包里已有的体力药，不会花钱购买",
          "default": false,
          "visible_when": {
            "mode": "sweep"
          }
        },
        {
          "key": "auto_team",
          "type": "switch",
          "label": "自动编队",
          "help": "关闭则使用你在游戏里保存的第一队",
          "default": true,
          "points": 0
        },
        {
          "key": "remark",
          "type": "text",
          "label": "备注",
          "maxlength": 60,
          "placeholder": "例如：第 3 关请带治疗"
        }
      ],
      "limits": {
        "max_units": 500
      }
    }
  },
  {
    "key": "starfall_daily",
    "label": "每日委托（基础价 + 附加项）",
    "definition": {
      "schema_version": 1,
      "code": "daily",
      "name": "每日委托",
      "description": "完成当日 4 个委托并领取奖励，可附加领取邮件、派遣。",
      "capability": "daily",
      "timeout_minutes": 30,
      "max_active_per_user": 3,
      "refund_policy": "full_on_system_fail",
      "member_discount": true,
      "base_points": 20,
      "fields": [
        {
          "key": "extras",
          "type": "checkbox",
          "label": "附加项目",
          "options": [
            {
              "value": "mail",
              "label": "领取邮件",
              "points": 0
            },
            {
              "value": "dispatch",
              "label": "探索派遣（收取并重新派出）",
              "points": 5
            },
            {
              "value": "shop",
              "label": "兑换商店每日免费物品",
              "points": 3
            }
          ],
          "default": [
            "mail"
          ]
        }
      ]
    }
  },
  {
